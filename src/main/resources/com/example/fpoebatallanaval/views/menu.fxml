<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="600.0" maxWidth="1000.0" minHeight="600.0" minWidth="1000.0" prefHeight="600.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.fpoebatallanaval.controller.MenuController">
   <children>
      <ImageView blendMode="SRC_ATOP" fitHeight="1000.0" fitWidth="1000.0" layoutY="-200.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/batalla-naval.png" />
         </image>
         <effect>
            <DropShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="DEFAULT" />
         </cursor>
      </ImageView>
      <Label alignment="CENTER" contentDisplay="CENTER" layoutX="295.0" layoutY="120.0" prefHeight="80.0" prefWidth="410.0" style="-fx-background-color: null;" text="BATALLA NAVAL" textFill="#d1cdcd" underline="true">
         <font>
            <Font name="Arial Black" size="40.0" />
         </font>
         <effect>
            <DropShadow />
         </effect>
         <cursor>
            <Cursor fx:constant="NONE" />
         </cursor>
      </Label>
      <VBox alignment="CENTER" layoutX="400.0" layoutY="220.0" prefHeight="300.0" prefWidth="200.0" spacing="20.0">
         <children>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButtonNuevaPartida" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to bottom, #005b9f, #003e73); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Nueva Partida">
               <font>
                  <Font size="16.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButtonCargarPartida" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to bottom, #005b9f, #003e73); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Cargar Partida">
               <font>
                  <Font size="16.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButtonModoMaestro" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to bottom, #005b9f, #003e73); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Modo Maestro">
               <font>
                  <Font size="16.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButtonInstrucciones" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to bottom, #005b9f, #003e73); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Instrucciones">
               <font>
                  <Font size="16.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#onActionButtonSalir" prefHeight="40.0" prefWidth="170.0" style="-fx-background-color: linear-gradient(to bottom, #005b9f, #003e73); -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" text="Salir">
               <font>
                  <Font size="16.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
         </children>
      </VBox>
   </children>
</AnchorPane>
